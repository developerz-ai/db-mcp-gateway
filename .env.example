# Copy to .env and fill in. .env is gitignored.
# bin/dev and bin/test source it; the gateway itself reads only the variables
# under "Gateway runtime" below. Every commented line shows the default.

# === Dev stack (docker-compose.dev.yml) ===
# Gateway state DB (the gateway's own Postgres)
STATE_DB_USER=gateway
STATE_DB_PASSWORD=gateway-dev-only
STATE_DB_NAME=gateway
STATE_DB_PORT=5433
# Example target Postgres
TARGET_DB_USER=app
TARGET_DB_PASSWORD=app-dev-only
TARGET_DB_NAME=app
TARGET_DB_PORT=5434
# Integration tests connect to the target through this URL.
TARGET_DB_URL=postgres://app:app-dev-only@localhost:5434/app
# Example target MongoDB
# TARGET_MONGO_USER=app
# TARGET_MONGO_PASSWORD=app-dev-only
# TARGET_MONGO_DB=app
# TARGET_MONGO_PORT=27018
# MySQL permissions store (permissions_store.driver: mysql)
# PERMISSIONS_MYSQL_USER=permissions
# PERMISSIONS_MYSQL_PASSWORD=permissions-dev-only
# PERMISSIONS_MYSQL_DB=permissions
# PERMISSIONS_MYSQL_ROOT_PASSWORD=mysql-dev-only
# PERMISSIONS_MYSQL_PORT=3307

# === Gateway runtime ===
# YAML config path; same as --config. The published image sets /etc/gateway/config.yml.
# DB_MCP_GATEWAY_CONFIG=config.yml

# --- Listeners ---
GATEWAY_BIND=127.0.0.1:8443
# Prometheus /metrics listener — never served on GATEWAY_BIND. Must differ from it.
# METRICS_BIND=127.0.0.1:9090
# Absolute path the MCP endpoint mounts at; a path the gateway already serves aborts boot.
# MCP_PATH=/mcp

# --- State DB ---
STATE_DB_URL=postgres://gateway:gateway-dev-only@localhost:5433/gateway
# Request-path pool; 0, or more than MAX_CONCURRENT_REQUESTS, aborts boot.
# STATE_DB_POOL_SIZE=10
# Only with permissions_store.driver: mysql — DSN of the MySQL 8 permissions store.
# PERMISSIONS_DB_DSN=mysql://permissions:permissions-dev-only@localhost:3307/permissions

# --- Load shedding (0 aborts boot) ---
# Process-wide in-flight ceiling; past it, 503.
# MAX_CONCURRENT_REQUESTS=512
# Per-caller in-flight ceiling; past it, 429.
# MAX_CONCURRENT_PER_IDENTITY=16

# --- Retention and caches ---
# Days the hourly pruner keeps audit rows; 0 aborts boot.
# AUDIT_RETENTION_DAYS=90
# Per-user grant cache TTL; bounds how long a revoked grant survives on a replica
# that missed the invalidation. Above 300 aborts boot.
# PERMISSIONS_CACHE_TTL_SECONDS=60
# Session cache freshness; bounds cross-replica revocation staleness. 0 = re-check every request.
# SESSION_CACHE_TTL_SECONDS=30

# --- OIDC ---
# OIDC_ISSUER and OIDC_CLIENT_ID are required at boot; an empty value aborts.
# The IdP is not contacted at boot, only at login.
OIDC_ISSUER=http://localhost:5556
OIDC_CLIENT_ID=dev
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:8443/auth/callback
# OIDC_AUDIENCE=                # defaults to OIDC_CLIENT_ID if unset
# OIDC_GROUPS_CLAIM=groups      # which claim carries group membership

# --- Session JWT (gateway-issued, HS256) ---
# At least 32 bytes and not the committed dev default, unless
# ALLOW_INSECURE_SIGNING_KEY=true — which is accepted only with a loopback
# OIDC_ISSUER (local dev). Generate one with: openssl rand -hex 32
# SESSION_SIGNING_KEY=
ALLOW_INSECURE_SIGNING_KEY=true
# Session (access token) lifetime, 1–168.
# SESSION_TTL_HOURS=8
# Absolute lifetime of a refresh-token chain, 1–366 days. Rotation renews the
# opaque token value but never this deadline; when it elapses the client must
# re-run /authorize. Raising it also widens how long IdP group changes
# (off-boarding) take to reach the gateway, since refresh re-uses the groups
# frozen at the original login.
# REFRESH_TTL_DAYS=1

# --- TLS ---
# The gateway refuses to boot without TLS unless TLS_DISABLED=true is set
# explicitly. Local dev → keep TLS_DISABLED=true. Production → unset it and
# point TLS_CERT_PATH / TLS_KEY_PATH at PEM files; SIGHUP reloads them in place.
TLS_DISABLED=true
# TLS_CERT_PATH=/etc/gateway/tls/tls.crt
# TLS_KEY_PATH=/etc/gateway/tls/tls.key

# --- Logging ---
# Unset → `info,sqlx::query=warn`. The `audit_stream` target always logs at INFO.
RUST_LOG=info,db_mcp_gateway=debug,sqlx=warn

# --- GlitchTip / Sentry error tracking ---
# Error tracking only — no performance tracing, profiling or replay. Unset or
# empty → disabled. A before_send scrubber redacts DSNs and passwords from
# every event. Never put live secrets here, even commented.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# --- Secret refs ---
# Any ${ENV:NAME} in the YAML config is read from the environment at boot; an
# unset one aborts boot. The quickstart config reads TARGET_DB_PASSWORD (above).
