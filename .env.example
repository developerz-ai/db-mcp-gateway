# Copy to .env and fill in. .env is gitignored.
# Required by bin/dev and bin/test against the local docker-compose.dev.yml.

# === Gateway state DB (the gateway's own Postgres) ===
STATE_DB_USER=gateway
STATE_DB_PASSWORD=gateway-dev-only
STATE_DB_NAME=gateway
STATE_DB_PORT=5433
STATE_DB_URL=postgres://gateway:gateway-dev-only@localhost:5433/gateway

# === Example target DB (a real Postgres the gateway can connect to for local dev) ===
TARGET_DB_USER=app
TARGET_DB_PASSWORD=app-dev-only
TARGET_DB_NAME=app
TARGET_DB_PORT=5434
TARGET_DB_URL=postgres://app:app-dev-only@localhost:5434/app

# === OIDC (real values come from your IdP; for local dev, use a mock IdP or skip auth in dev profile) ===
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8443/auth/callback
# OIDC_AUDIENCE=                # defaults to OIDC_CLIENT_ID if unset
# OIDC_GROUPS_CLAIM=groups      # which claim carries group membership
# OIDC_MOCK_MODE=false          # tests set this; never enable in prod

# === Session JWT (gateway-issued, HS256) ===
# SESSION_TTL_HOURS=8
SESSION_SIGNING_KEY=dev-only-session-signing-key-change-me

# === Gateway listen settings ===
GATEWAY_BIND=127.0.0.1:8443
GATEWAY_EXTERNAL_URL=http://localhost:8443

# === TLS ===
# Gateway refuses to boot without TLS unless TLS_DISABLED=true is set
# explicitly. Local dev → keep TLS_DISABLED=true (no certs to fuss with).
# Production → unset TLS_DISABLED and point TLS_CERT_PATH / TLS_KEY_PATH at
# the cert-manager-managed PEMs. SIGHUP reloads them in place without
# dropping existing connections.
TLS_DISABLED=true
# TLS_CERT_PATH=/etc/gateway/tls/tls.crt
# TLS_KEY_PATH=/etc/gateway/tls/tls.key

# === Logging ===
RUST_LOG=info,db_mcp_gateway=debug,sqlx=warn
