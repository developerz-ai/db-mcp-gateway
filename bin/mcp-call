#!/usr/bin/env bash
# bin/mcp-call — one MCP tools/call against a running gateway, as a service token.
#   bin/mcp-call <tool> [json-arguments]
#   bin/mcp-call --list                      tools/list
# e.g. bin/mcp-call run_query '{"server":"local","database":"shop","sql":"select * from orders"}'
# Defaults target `bin/run`: http://127.0.0.1:<GATEWAY_BIND port><MCP_PATH> and
# the token bin/run minted (target/dev/service-token). Override with MCP_URL
# and DBMCP_TOKEN (e.g. the examples/demo token). Exit 1 on a non-2xx HTTP
# status, a body that is not a JSON-RPC envelope, a JSON-RPC error, or a tool
# result with isError. Needs jq.
set -euo pipefail

cd "$(dirname "$0")/.."

# shellcheck source=bin/lib/dotenv.sh
. bin/lib/dotenv.sh

usage() { echo "usage: bin/mcp-call <tool> [json-arguments] | bin/mcp-call --list" >&2; exit 2; }

case "${1:-}" in
  --list) body='{"jsonrpc":"2.0","id":1,"method":"tools/list"}' ;;
  '' | -*) usage ;;
  *)
    [[ $1 =~ ^[a-z_]+$ ]] || usage
    body=$(printf '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"%s","arguments":%s}}' \
      "$1" "${2:-"{}"}")
    ;;
esac

bind=${GATEWAY_BIND:-127.0.0.1:8443}
url=${MCP_URL:-http://127.0.0.1:${bind##*:}${MCP_PATH:-/mcp}}
if [[ -z ${DBMCP_TOKEN:-} ]]; then
  token_file=target/dev/service-token
  [[ -s $token_file ]] || { echo "bin/mcp-call: no token: run bin/run first, or set DBMCP_TOKEN" >&2; exit 2; }
  DBMCP_TOKEN=$(<"$token_file")
fi

command -v jq >/dev/null 2>&1 || { echo "bin/mcp-call: jq is required" >&2; exit 2; }
response=$(mktemp)
trap 'rm -f "$response"' EXIT

# The token goes to curl on stdin, never on its command line (visible in ps).
status=$(printf 'header = "Authorization: Bearer %s"\n' "$DBMCP_TOKEN" \
  | curl -sS --config - -H 'Content-Type: application/json' --data-binary "$body" \
      -o "$response" -w '%{http_code}' "$url")

if [[ ! $status =~ ^2[0-9][0-9]$ ]]; then
  echo "bin/mcp-call: HTTP $status from $url" >&2
  cat "$response" >&2
  exit 1
fi
# One verdict from one jq run over the whole body: exactly one JSON value, a
# JSON-RPC 2.0 object answering id 1 with exactly one of `result` / `error`,
# each an object. A jq failure (not JSON at all) is a verdict too: invalid.
verdict=$(jq -rs '
  if length == 1 and (.[0] | type) == "object" then .[0] else null end
  | if . != null and .jsonrpc == "2.0" and .id == 1
       and (has("result") != has("error"))
       and ((.result // .error) | type) == "object"
    then (if has("error") or .result.isError == true then "failed" else "ok" end)
    else "invalid" end
' "$response" 2>/dev/null) || verdict=invalid
if [[ $verdict == invalid ]]; then
  echo "bin/mcp-call: the response is not a JSON-RPC envelope:" >&2
  cat "$response" >&2
  exit 1
fi
jq . "$response"
[[ $verdict == ok ]]
