#!/usr/bin/env bash
# bin/check — resource preflight, then the unchanged CI gate.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"

unavailable() {
  printf 'check: %s (gate not run; exit 75)\n' "$1" >&2
  exit 75
}

for tool in cargo rustc cc make grep docker; do
  command -v "$tool" >/dev/null 2>&1 || unavailable "Required tool '$tool' is missing. Install the host prerequisites documented in CONTRIBUTING.md, then retry."
done

# Do not relay probe output: Docker and toolchain errors can expose host settings.
cargo --version >/dev/null 2>&1 || unavailable 'Cargo cannot run. Install the pinned Rust toolchain, then retry.'
rustc --version >/dev/null 2>&1 || unavailable 'rustc cannot run. Install the pinned Rust toolchain, then retry.'
cargo fmt --version >/dev/null 2>&1 || unavailable 'rustfmt is unavailable. Install the rustfmt component for the pinned toolchain, then retry.'
cargo clippy --version >/dev/null 2>&1 || unavailable 'Clippy is unavailable. Install the clippy component for the pinned toolchain, then retry.'
docker compose version >/dev/null 2>&1 || unavailable 'Docker Compose v2 is unavailable. Install or enable the Compose plugin, then retry.'
docker info >/dev/null 2>&1 || unavailable 'Docker daemon is unreachable. Start Docker and grant your user daemon access, then retry.'

# Only preflight failures use 75; preserve every status returned by the real gate.
exec bin/ci
