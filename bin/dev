#!/usr/bin/env bash
# bin/dev — local dev stack control.
#   bin/dev up           start state-db + target-db + target-mongo + permissions-mysql + target-redis + target-dragonfly (waits for health)
#   bin/dev down         stop and remove containers
#   bin/dev reset        down + remove volumes (fresh DBs)
#   bin/dev logs [svc]   follow logs
#   bin/dev psql state   psql into state-db
#   bin/dev psql target  psql into target-db
#   bin/dev ysqlsh       ysqlsh into target-yugabyte (start it: bin/test-yugabyte,
#                        or `docker compose -f docker-compose.dev.yml --profile yugabyte up -d --wait target-yugabyte`)
#   bin/dev mongosh      mongosh into target-mongo
#   bin/dev mysql        mysql into permissions-mysql
#   bin/dev redis        redis-cli into target-redis as the gateway's ACL user
#   bin/dev ps           compose ps
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ -f .env ]]; then
  set -a; . ./.env; set +a
fi

COMPOSE=(docker compose -f docker-compose.dev.yml)

case "${1:-up}" in
  up)    "${COMPOSE[@]}" up -d --wait ;;
  down)  "${COMPOSE[@]}" down ;;
  reset) "${COMPOSE[@]}" down -v ;;
  # "$@" not "${@:-}": with no service argument the latter expands to a single
  # empty string, so bare `bin/dev logs` ran `logs -f ""` → "no such service".
  logs)  shift; "${COMPOSE[@]}" logs -f "$@" ;;
  ps)    "${COMPOSE[@]}" ps ;;
  psql)
    target="${2:-state}"
    case "$target" in
      state)  exec "${COMPOSE[@]}" exec state-db  psql -U "${STATE_DB_USER:-gateway}"  -d "${STATE_DB_NAME:-gateway}" ;;
      target) exec "${COMPOSE[@]}" exec target-db psql -U "${TARGET_DB_USER:-app}"    -d "${TARGET_DB_NAME:-app}" ;;
      *) echo "unknown psql target: $target (use 'state' or 'target')" >&2; exit 2 ;;
    esac
    ;;
  ysqlsh)
    # yugabyted binds YSQL to the container address, not localhost.
    exec "${COMPOSE[@]}" --profile yugabyte exec \
      -e PGPASSWORD="${TARGET_DB_PASSWORD:-app-dev-only}" target-yugabyte \
      bash -c 'exec bin/ysqlsh -h "$(hostname -i | awk "{print \$1}")" -U "$1" -d "$2"' ysqlsh \
      "${TARGET_DB_USER:-app}" "${TARGET_DB_NAME:-app}"
    ;;
  mongosh)
    exec "${COMPOSE[@]}" exec target-mongo mongosh \
      --username "${TARGET_MONGO_USER:-app}" \
      --password "${TARGET_MONGO_PASSWORD:-app-dev-only}" \
      --authenticationDatabase admin \
      "${TARGET_MONGO_DB:-app}"
    ;;
  mysql)
    exec "${COMPOSE[@]}" exec permissions-mysql mysql \
      -u"${PERMISSIONS_MYSQL_USER:-permissions}" \
      -p"${PERMISSIONS_MYSQL_PASSWORD:-permissions-dev-only}" \
      "${PERMISSIONS_MYSQL_DB:-permissions}"
    ;;
  redis)
    # The gateway's own least-privilege ACL user, provisioned by the suite
    # (`ACL SETUSER` in tests/common/redis_target.rs:ensure_read_user) — the
    # defaults are tests/common/env.rs::REDIS_READ_{USER,PASSWORD}. On the
    # logical DB the YAML `databases[].name` selects.
    exec "${COMPOSE[@]}" exec target-redis redis-cli \
      --user gateway_ro \
      -a "gateway-ro-dev-only" \
      --no-auth-warning \
      -n 3
    ;;
  *) echo "usage: bin/dev {up|down|reset|logs [svc]|ps|psql state|psql target|ysqlsh|mongosh|mysql|redis}" >&2; exit 2 ;;
esac
