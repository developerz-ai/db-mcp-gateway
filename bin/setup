#!/usr/bin/env bash
# bin/setup — check host prerequisites, fetch dependencies, start healthy services.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"

fail() {
  printf 'setup: %s\n' "$1" >&2
  exit 1
}

command -v cargo >/dev/null 2>&1 || fail 'Cargo is required. Install Rust using your trusted toolchain manager, then retry.'
command -v docker >/dev/null 2>&1 || fail 'Docker is required. Install Docker Engine or Docker Desktop with Compose v2, then retry.'
docker compose version >/dev/null 2>&1 || fail 'Docker Compose v2 is required. Install or enable the Docker Compose plugin, then retry.'
docker info >/dev/null 2>&1 || fail 'Docker daemon is unreachable. Start Docker and grant your user daemon access, then retry.'
command -v dpkg >/dev/null 2>&1 || fail 'This setup script requires a Debian/Ubuntu host with dpkg and apt-get.'

# Suppress subprocess output: tool and Compose errors can include environment values.
if command -v mise >/dev/null 2>&1; then
  echo '→ installing configured mise tools'
  mise install >/dev/null 2>&1 || fail 'mise install failed. Check trusted mise configuration and network access, then retry.'
else
  echo '→ mise not installed (optional); using host Rust tools'
fi
cargo --version >/dev/null 2>&1 || fail 'Cargo cannot run the pinned toolchain. Install the toolchain from rust-toolchain.toml, then retry.'

echo '→ checking host packages'
if ! dpkg -s build-essential openssl curl >/dev/null 2>&1; then
  command -v apt-get >/dev/null 2>&1 || fail 'Install build-essential, openssl and curl with apt-get, then retry.'
  APT=(apt-get)
  if (( EUID != 0 )); then
    command -v sudo >/dev/null 2>&1 || fail 'Install build-essential, openssl and curl as administrator, then retry.'
    sudo -n true >/dev/null 2>&1 || fail 'Package installation requires non-interactive sudo. Ask an administrator to install build-essential, openssl and curl, then retry.'
    APT=(sudo -n apt-get)
  fi
  "${APT[@]}" update >/dev/null 2>&1 || fail 'Package index update failed. Check apt repositories and network access, then retry.'
  "${APT[@]}" install -y --no-install-recommends build-essential openssl curl >/dev/null 2>&1 || fail 'Host package installation failed. Ask an administrator to install build-essential, openssl and curl, then retry.'
fi

echo '→ fetching locked Rust dependencies'
cargo fetch --locked >/dev/null 2>&1 || fail 'Locked dependency fetch failed. Check registry access and Cargo.lock consistency, then retry.'
echo '→ starting dependency services and waiting for health'
docker compose -f docker-compose.dev.yml up -d --wait >/dev/null 2>&1 || fail 'Dependency startup failed. Check Docker resources, image registry access, local port availability and service health; review diagnostics locally without sharing credentials.'
echo '✓ setup complete (dependency services only; gateway startup is separate)'
