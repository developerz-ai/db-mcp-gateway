#!/usr/bin/env bash
# one-command setup — established by dz-runner setup mode. One command; adjust as the repo grows.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v mise >/dev/null && mise install
export PATH="$HOME/.cargo/bin:$PATH" && (dpkg -s build-essential openssl curl >/dev/null 2>&1 || (sudo -n apt-get update && sudo -n apt-get install -y --no-install-recommends build-essential openssl curl)) && cargo fetch --locked && docker compose -f docker-compose.dev.yml up -d --wait
