#!/usr/bin/env bash
# bin/setup — check host prerequisites, install the dev tools, fetch
# dependencies, start healthy services.
#   bin/setup [--hooks]    --hooks: also `git config core.hooksPath .githooks`
# Tool output goes to target/setup.log (local; it can hold environment
# values — never paste it publicly). On failure the last lines are shown.
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"

NEXTEST_VERSION=0.9.151     # same as CI's test job
CARGO_AUDIT_VERSION=0.23.0  # same as CI's audit job

hooks=false
case "${1:-}" in
  '') ;;
  --hooks) hooks=true ;;
  *) echo 'usage: bin/setup [--hooks]' >&2; exit 2 ;;
esac

mkdir -p target
log=target/setup.log
(umask 077 && : > "$log")

fail() {
  printf 'setup: %s\n' "$1" >&2
  if [[ -s $log ]]; then
    printf -- '--- last lines of %s ---\n' "$log" >&2
    tail -n 20 "$log" >&2
  fi
  exit 1
}

# Run a step with its output in the log, failing with $1 as the message.
step() {
  local message=$1
  shift
  printf '\n$ %s\n' "$*" >> "$log"
  "$@" >> "$log" 2>&1 || fail "$message"
}

command -v cargo >/dev/null 2>&1 || fail 'Cargo is required. Install Rust using your trusted toolchain manager, then retry.'
command -v docker >/dev/null 2>&1 || fail 'Docker is required. Install Docker Engine or Docker Desktop with Compose v2, then retry.'
docker compose version >/dev/null 2>&1 || fail 'Docker Compose v2 is required. Install or enable the Docker Compose plugin, then retry.'
docker info >/dev/null 2>&1 || fail 'Docker daemon is unreachable. Start Docker and grant your user daemon access, then retry.'

if command -v mise >/dev/null 2>&1; then
  echo '→ installing configured mise tools'
  step 'mise install failed. Check trusted mise configuration and network access, then retry.' mise install
else
  echo '→ mise not installed (optional); using host Rust tools'
fi
step 'Cargo cannot run the pinned toolchain. Install the toolchain from rust-toolchain.toml, then retry.' cargo --version

echo '→ checking host packages'
if command -v dpkg >/dev/null 2>&1; then
  if ! dpkg -s build-essential libclang-dev openssl curl >/dev/null 2>&1; then
    command -v apt-get >/dev/null 2>&1 || fail 'Install build-essential, libclang-dev, openssl and curl with apt-get, then retry.'
    APT=(apt-get)
    if (( EUID != 0 )); then
      command -v sudo >/dev/null 2>&1 || fail 'Install build-essential, libclang-dev, openssl and curl as administrator, then retry.'
      APT=(sudo -n apt-get)
    fi
    step 'Package index update failed. Check apt repositories and network access, then retry.' "${APT[@]}" update
    step 'Host package installation failed. Ask an administrator to install build-essential, libclang-dev, openssl and curl, then retry.' \
      "${APT[@]}" install -y --no-install-recommends build-essential libclang-dev openssl curl
  fi
else
  echo '  non-Debian host: not installing packages, only checking for them'
  for tool in cc clang make openssl curl; do
    command -v "$tool" >/dev/null 2>&1 || fail "'$tool' is missing. Install a C toolchain, clang (libclang), make, openssl and curl with your package manager, then retry."
  done
fi

# Prebuilt binaries first: compiling nextest and cargo-audit from source takes minutes.
nextest_platform() {
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) echo linux ;;
    Linux-aarch64 | Linux-arm64) echo linux-arm ;;
    Darwin-*) echo mac ;;
    *) return 1 ;;
  esac
}

install_nextest() {
  local platform
  if command -v cargo-binstall >/dev/null 2>&1; then
    cargo binstall --no-confirm --locked "cargo-nextest@${NEXTEST_VERSION}" && return 0
  fi
  if platform=$(nextest_platform); then
    curl -fsSL "https://get.nexte.st/${NEXTEST_VERSION}/${platform}" | tar -xzf - -C "${CARGO_HOME:-$HOME/.cargo}/bin" && return 0
  fi
  cargo install --locked "cargo-nextest@${NEXTEST_VERSION}"
}

install_cargo_audit() {
  if command -v cargo-binstall >/dev/null 2>&1; then
    cargo binstall --no-confirm --locked "cargo-audit@${CARGO_AUDIT_VERSION}" && return 0
  fi
  cargo install --locked "cargo-audit@${CARGO_AUDIT_VERSION}"
}

if ! command -v cargo-nextest >/dev/null 2>&1; then
  echo "→ installing cargo-nextest ${NEXTEST_VERSION} (test runner)"
  step 'cargo-nextest install failed. Check network access, then retry.' install_nextest
fi
if ! command -v cargo-audit >/dev/null 2>&1; then
  echo "→ installing cargo-audit ${CARGO_AUDIT_VERSION} (advisory check)"
  step 'cargo-audit install failed. Check network access, then retry.' install_cargo_audit
fi

echo '→ fetching locked Rust dependencies'
step 'Locked dependency fetch failed. Check registry access and Cargo.lock consistency, then retry.' cargo fetch --locked
echo '→ starting dependency services and waiting for health'
step 'Dependency startup failed. Check Docker resources, image registry access, local port availability and service health.' \
  docker compose -f docker-compose.dev.yml up -d --wait

if $hooks; then
  git config core.hooksPath .githooks
  echo '→ git hooks enabled (.githooks: pre-commit fmt + token scan, pre-push clippy + unit tests)'
else
  echo "  git hooks: opt in with 'bin/setup --hooks' (or 'git config core.hooksPath .githooks')"
fi
echo '✓ setup complete — next: bin/run, then bin/seed and bin/mcp-call (see CONTRIBUTING.md)'
