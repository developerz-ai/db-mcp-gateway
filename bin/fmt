#!/usr/bin/env bash
# bin/fmt — format every file in place.
#   bin/fmt --changed [base]  only the .rs files changed since `base`
#                             (default origin/main; committed, staged or not)
#                             plus untracked ones — the files you touched, not
#                             another agent's in-flight edits. Each file alone:
#                             skip_children keeps rustfmt from following a
#                             `mod x;` into files you did not list.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ ${1:-} != --changed ]]; then
  (( $# == 0 )) || { echo 'usage: bin/fmt [--changed [base]]' >&2; exit 2; }
  exec cargo fmt --all
fi
(( $# <= 2 )) || { echo 'usage: bin/fmt [--changed [base]]' >&2; exit 2; }
base=${2:-origin/main}

if ! merge_base=$(git merge-base "$base" HEAD 2>/dev/null); then
  echo "bin/fmt: cannot resolve '$base' (git fetch origin main, or pass a base)" >&2
  exit 2
fi

# Collected in a file, not a process substitution, so a failing git aborts.
list=$(mktemp)
if ! { git diff -z --name-only --diff-filter=d "$merge_base" -- \
    && git ls-files -z --others --exclude-standard; } > "$list"; then
  rm -f "$list"
  exit 1
fi
files=()
while IFS= read -r -d '' file; do
  [[ $file == *.rs ]] && files+=("$file")
done < "$list"
rm -f "$list"

if (( ${#files[@]} == 0 )); then
  echo "bin/fmt: no changed .rs files since $base"
  exit 0
fi
printf 'bin/fmt: %s\n' "${files[@]}"
exec rustfmt --config skip_children=true "${files[@]}"
