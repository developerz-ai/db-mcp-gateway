#!/usr/bin/env bash
# bin/test — unit + integration tests. Brings up the dev stack if needed.
#   bin/test --unit   lib + bin unit tests and tests/it_offline only: no Docker,
#                     no database (the pre-push hook's loop)
# Runs cargo-nextest when installed (.config/nextest.toml), else `cargo test`.
# Queued behind other heavy runs on this checkout (bin/lib/queue.sh;
# DBMCP_NO_QUEUE=1 opts out).
# Pass-through args go to the runner (e.g. bin/test --test smoke -- --nocapture);
# nextest accepts the libtest flags after `--`.
set -euo pipefail

cd "$(dirname "$0")/.."

# shellcheck source=bin/lib/dotenv.sh
. bin/lib/dotenv.sh
# shellcheck source=bin/lib/queue.sh
. bin/lib/queue.sh

if [[ ${1:-} == --unit ]]; then
  shift
  unit=(--lib --bins --test it_offline --all-features)
  queue_lock heavy "bin/test --unit $*"
  if command -v cargo-nextest >/dev/null 2>&1; then
    exec cargo nextest run "${unit[@]}" "$@"
  fi
  exec cargo test "${unit[@]}" "$@"
fi

# Full suite: the machine-wide ledger when present, then the repo's own
# compile queue and the dev-DB lock (one suite at a time on the shared DBs).
queue_heavy_reexec bin/test "$@"
queue_lock heavy "bin/test $*"
queue_lock db "bin/test $*"

compose=(docker compose -f docker-compose.dev.yml)

unavailable() { echo "Required prerequisite unavailable: $*" >&2; exit 75; }

# Name the unreachable resource. An environment fault must be distinguishable
# from a red change, so each probe says which resource it was.
command -v docker >/dev/null 2>&1 || unavailable 'Docker CLI'
docker info >/dev/null 2>&1 || unavailable 'Docker daemon'
"${compose[@]}" version >/dev/null 2>&1 || unavailable 'Docker Compose'

# The services that never became healthy. Only the service name, its state and
# its health are read out — never an environment value, never a credential.
unhealthy_services() {
  local service state health state_problem health_problem
  "${compose[@]}" ps -a --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null \
  | while read -r service state health; do
      [[ -n $service && -n $state ]] || continue
      state_problem=''
      case "$state" in
        running|Running|up) ;;
        *) state_problem="$state" ;;
      esac
      health_problem=''
      case "$health" in
        healthy|Healthy|'') ;;
        *) health_problem="$health" ;;
      esac
      if [[ -n $state_problem || -n $health_problem ]]; then
        printf '%s' "$service"
        if [[ -n $state_problem ]]; then printf ' (state: %s)' "$state_problem"; fi
        if [[ -n $health_problem ]]; then printf ' (health: %s)' "$health_problem"; fi
        printf '\n'
      fi
    done
}

# A running state DB alone does not imply the other integration stores are ready.
# Compose up is idempotent and waits for every service's healthcheck.
echo "→ ensuring dev stack is healthy for tests"
up_rc=0
"${compose[@]}" up -d --wait || up_rc=$?
if (( up_rc != 0 )); then
  # The daemon may have died while the stack came up: that is a resource fault.
  if ! docker info >/dev/null 2>&1; then
    echo 'Required prerequisite unavailable: Docker daemon' >&2
    exit 75
  fi
  # A malformed compose file is a broken change, not an unreachable resource.
  # Its own status is preserved, so the platform blames the change and not the
  # box. Exit 75 stays reserved for a resource or a health failure.
  config_rc=0
  "${compose[@]}" config --quiet >/dev/null || config_rc=$?
  if (( config_rc != 0 )); then
    echo "docker compose configuration is invalid (rc=$config_rc); not an environment fault" >&2
    exit "$config_rc"
  fi
  unhealthy=$(unhealthy_services || true)
  if [[ -n $unhealthy ]]; then
    echo 'Required prerequisite unavailable: dev stack service(s) never became healthy:' >&2
    printf '%s\n' "$unhealthy" >&2
    echo 'Inspect with: docker compose -f docker-compose.dev.yml logs' >&2
    exit 75
  fi
  # A command failure with no unhealthy service to show for it: keep compose's
  # own status instead of calling it an environment fault.
  echo "docker compose up -d --wait failed (rc=$up_rc) without an unhealthy service" >&2
  exit "$up_rc"
fi

if command -v cargo-nextest >/dev/null 2>&1; then
  exec cargo nextest run --all-targets --all-features "$@"
fi
exec cargo test --all-targets --all-features "$@"
