#!/usr/bin/env bash
# bin/test — unit + integration tests. Brings up the dev stack if needed.
# Pass-through args go to `cargo test` (e.g. bin/test --test smoke -- --nocapture).
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ -f .env ]]; then
  set -a; . ./.env; set +a
fi

compose=(docker compose -f docker-compose.dev.yml)

unavailable() { echo "Required prerequisite unavailable: $*" >&2; exit 75; }

# Name the unreachable resource. An environment fault must be distinguishable
# from a red change, so each probe says which resource it was.
command -v docker >/dev/null 2>&1 || unavailable 'Docker CLI'
docker info >/dev/null 2>&1 || unavailable 'Docker daemon'
"${compose[@]}" version >/dev/null 2>&1 || unavailable 'Docker Compose'

# The services that never became healthy. Only the service name, its state and
# its health are read out — never an environment value, never a credential.
unhealthy_services() {
  local service state health state_problem health_problem
  "${compose[@]}" ps -a --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null \
  | while read -r service state health; do
      [[ -n $service && -n $state ]] || continue
      state_problem=''
      case "$state" in
        running|Running|up) ;;
        *) state_problem="$state" ;;
      esac
      health_problem=''
      case "$health" in
        healthy|Healthy|'') ;;
        *) health_problem="$health" ;;
      esac
      if [[ -n $state_problem || -n $health_problem ]]; then
        printf '%s' "$service"
        if [[ -n $state_problem ]]; then printf ' (state: %s)' "$state_problem"; fi
        if [[ -n $health_problem ]]; then printf ' (health: %s)' "$health_problem"; fi
        printf '\n'
      fi
    done
}

# A running state DB alone does not imply the other integration stores are ready.
# Compose up is idempotent and waits for every service's healthcheck.
echo "→ ensuring dev stack is healthy for tests"
if ! "${compose[@]}" up -d --wait; then
  unhealthy=$(unhealthy_services || true)
  if [[ -n $unhealthy ]]; then
    echo 'Required prerequisite unavailable: dev stack service(s) never became healthy:' >&2
    printf '%s\n' "$unhealthy" >&2
    echo 'Inspect with: docker compose -f docker-compose.dev.yml logs' >&2
  else
    echo 'Required prerequisite unavailable: dev stack did not become healthy (docker compose up -d --wait failed)' >&2
  fi
  exit 75
fi

exec cargo test --all-targets --all-features "$@"
