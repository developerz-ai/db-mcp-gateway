#!/usr/bin/env bash
# Local quality gates equivalent to CI; never installs or publishes artifacts.
#
# Exit codes:
#   0   every job that ran passed
#   75  a REQUIRED resource is unreachable, so the gate cannot grade
#   *   a job that ran and failed keeps its own non-zero status
#
# bin/check, the documented entry point, owns the REQUIRED-tool refusal: it
# preflights the toolchain and Docker (exit 75) before exec-ing this script,
# so no job here re-implements that check. ci.yml's SHA-pin validation and
# secret-scan are deliberately not mirrored here: the workflow holds the only
# copy, and a local re-implementation would drift from the regexes and path
# exclusions it mirrors. A missing GATE-SCOPED toolchain — cargo-audit (the
# audit job) or Node 20+/npm plus the installed website dependencies (the
# Pages job) — makes that one job report 'NOT RUN' while every other job is
# still graded. A skip is never silent: it is printed and repeated in the
# final summary.
set -euo pipefail
cd "$(dirname "$0")/.."

skipped_jobs=()

# Every job the gate runs, in the order it runs them. `pending_jobs` holds the
# ones the gate has not reached yet: when the gate stops early, the EXIT trap
# names all of them, so no job is ever silently not run.
pending_jobs=(
  'orchestration regression'
  'fmt + clippy'
  'test'
  'cargo audit'
  'pages typecheck/build/artifact guard'
)

not_run() {
  local notice="NOT RUN: $1 - $2 ($3)"
  echo "$notice"
  skipped_jobs+=("$notice")
}

# The gate reached a job: it leaves the pending list whether it passed or
# failed. The name is checked so a reordered script cannot silently rename a
# job the trap still has to report.
job_reached() {
  if [[ ${pending_jobs[0]:-} != "$1" ]]; then
    echo "Internal error: expected job '${pending_jobs[0]:-}', reached '$1'" >&2
    exit 70
  fi
  pending_jobs=("${pending_jobs[@]:1}")
}

# Name every job the gate did not reach. The notice is the one a toolchain
# skip uses, so a job that never ran is never silently dropped.
finish() {
  local rc=$?
  local -a missed=()
  local job notice
  if (( rc == 0 )); then
    return 0
  fi
  if (( ${#pending_jobs[@]} > 0 )); then
    for job in "${pending_jobs[@]}"; do
      missed+=("NOT RUN: $job - the gate stopped before this job (fix the failing job and re-run)")
    done
  fi
  if (( ${#missed[@]} == 0 )); then
    return 0
  fi
  for notice in "${missed[@]}"; do
    echo "$notice" >&2
  done
  echo 'Jobs not reached (the gate stopped before them):' >&2
  for notice in "${missed[@]}"; do
    echo "  $notice" >&2
  done
  return 0
}
trap finish EXIT

# Shared box: cap cargo's build parallelism.
export CARGO_BUILD_JOBS=2

job_reached 'orchestration regression'
# tests/bin/check.test.sh replaces this entry in its own fixture; the real
# script never recurses into the gate.
bash tests/bin/check.test.sh
job_reached 'fmt + clippy'
bin/lint
job_reached 'test'
bin/test

echo '→ cargo audit'
job_reached 'cargo audit'
if command -v cargo-audit >/dev/null 2>&1; then
  # CI's exact command (.github/workflows/ci.yml, audit job). The single
  # ignore is the one .cargo/audit.toml already justifies; stating it on the
  # command line keeps the local gate identical to CI instead of leaning on
  # cargo-audit's config discovery.
  cargo audit --ignore RUSTSEC-2023-0071
else
  not_run 'cargo audit' 'cargo-audit is not on PATH' \
    'install: cargo install cargo-audit'
fi

echo '→ website typecheck, build and Pages artifact guard'
job_reached 'pages typecheck/build/artifact guard'
# GATE-SCOPED prerequisites: absent -> this job is skipped, not the gate.
pages_reason=''
pages_fix=''
if ! command -v node >/dev/null 2>&1; then
  pages_reason='Node 20+ is not on PATH'
  pages_fix='install: Node 20+ and npm'
elif ! node -e 'if (Number(process.versions.node.split(".")[0]) < 20) process.exit(1)' \
  >/dev/null 2>&1; then
  pages_reason='an older Node than 20 is on PATH'
  pages_fix='install: Node 20+ and npm'
elif ! command -v npm >/dev/null 2>&1; then
  pages_reason='npm is not on PATH'
  pages_fix='install: Node 20+ and npm'
else
  for tool in tsc docusaurus; do
    if [[ ! -x website/node_modules/.bin/$tool ]]; then
      pages_reason='website dependencies are absent'
      pages_fix='prepare: cd website && npm ci'
      break
    fi
  done
fi
if [[ -n $pages_reason ]]; then
  not_run 'pages typecheck/build/artifact guard' "$pages_reason" "$pages_fix"
else
  (
    cd website
    npm run typecheck
    npm run build
    [[ -d build ]] || { echo 'Website build directory missing' >&2; exit 1; }
    # Capture find's status directly: process substitution would hide errors.
    offenders=$(find build -type f \
      \( -iname '*.yaml' -o -iname '*.yml' \
         -o -iname '*.env' -o -iname '.env.*' \
         -o -iname '*.pem' -o -iname '*.key' \
         -o -iname '*.toml' -o -iname '*.sql' \))
    if [[ -n $offenders ]]; then
      echo 'Sensitive/config asset detected in Pages artifact; refusing to pass' >&2
      exit 1
    fi
  )
fi

if (( ${#skipped_jobs[@]} == 0 )); then
  echo '✓ Local quality checks passed (no publishing or deployment)'
else
  echo 'Jobs not run (their toolchain is absent; every other job was graded):'
  for notice in "${skipped_jobs[@]}"; do
    echo "  $notice"
  done
  echo '✓ Local quality checks passed for the gates that ran (no publishing or deployment)'
fi
