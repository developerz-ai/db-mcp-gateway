#!/usr/bin/env bash
# bin/secret-scan — no literal service-token value (spec 14, #190) in the git
# index: file contents (as bytes), file NAMES and symlink TARGETS. One scanner
# for every gate: CI's secret-scan job and bin/ci run it over every tracked
# path, .githooks/pre-commit runs it with --staged over the added, copied,
# modified, renamed and retyped paths of the staged change (a deletion stages
# nothing, so removing a leak always commits).
#
# Exit: 0 clean, 1 a token was found, 2 the scan could not run (fail-closed: a
# broken scanner never reads as clean). The report names locations only —
# `path:line` for a content hit, the path for a name or link-target hit —
# with every token inside a path masked and control characters replaced: the
# output is public (CI logs, PR comments).
#
# Exempt paths are the only places a literal token legitimately lives: test
# fixtures, spec/docs examples, the example config, the workflows, the loader
# unit-test fixtures.
set -euo pipefail
cd "$(dirname "$0")/.."

token_re='dbmcp_svc_[0-9a-f]{64}'
exempt=(':!tests/**' ':!website/**' ':!config/example.yaml' ':!.github/**' ':!src/config/yaml/**')
scope='tracked files hold'
if [[ ${1:-} == --staged ]]; then
  scope='the staged change adds'
elif [[ $# -gt 0 ]]; then
  echo 'usage: bin/secret-scan [--staged]' >&2
  exit 2
fi

scratch=$(mktemp -d) || { echo 'secret scan could not run (mktemp failed)' >&2; exit 2; }
trap 'rm -rf "$scratch"' EXIT
scan_error() { echo "secret scan could not run ($1) — refusing to read it as clean." >&2; exit 2; }

# Paths stay NUL-delimited end to end: a newline inside a file name would
# otherwise split it into pathspecs that match nothing, and its blob would
# never be scanned.
if [[ $scope == 'the staged change adds' ]]; then
  git diff --cached --name-only -z --diff-filter=ACMRT -- . "${exempt[@]}" > "$scratch/paths" \
    || scan_error 'git diff --name-only failed'
else
  git ls-files -z -- . "${exempt[@]}" > "$scratch/paths" || scan_error 'git ls-files failed'
fi
mapfile -d '' -t paths < "$scratch/paths"
(( ${#paths[@]} )) || exit 0
declare -A wanted=()
for path in "${paths[@]}"; do wanted[$path]=1; done

# Every staged path is in the index, so the stage entries come from one
# pathspec-scoped call, filtered here: the path list never reaches argv.
git ls-files --stage -z -- . "${exempt[@]}" > "$scratch/entries" \
  || scan_error 'git ls-files --stage failed'
mapfile -d '' -t entries < "$scratch/entries"

hits=()
for path in "${paths[@]}"; do
  if [[ $path =~ $token_re ]]; then hits+=("$path"); fi
done

# Contents, as bytes (`--text`): a binary blob is scanned too. Captured to a
# file, not piped: an early exit downstream cannot SIGPIPE git into a pass.
# The paths go in batches of at most batch_bytes: the whole list can exceed
# the OS argument limit, and a git that cannot launch is no clean result.
batch_bytes=65536
byte_length() { local LC_ALL=C; len=${#1}; }
grep_batch() {
  git --literal-pathspecs grep --cached --text -l -z -E "$token_re" -- "$@" >> "$scratch/grep" \
    || (( $? == 1 )) || scan_error 'git grep failed'
}
: > "$scratch/grep"
batch=()
size=0
for path in "${paths[@]}"; do
  byte_length "$path"
  if (( ${#batch[@]} && size + len + 1 > batch_bytes )); then
    grep_batch "${batch[@]}"
    batch=()
    size=0
  fi
  batch+=("$path")
  (( size += len + 1 ))
done
grep_batch "${batch[@]}"
mapfile -d '' -t by_content < "$scratch/grep"
declare -A content_hit=()
for path in "${by_content[@]}"; do content_hit[$path]=1; done

# grep: 0 is a match, 1 the only clean result, anything else (a missing or
# broken grep) a scan that did not run.
for entry in "${entries[@]}"; do
  read -r mode blob _ <<< "${entry%%$'\t'*}"
  path=${entry#*$'\t'}
  [[ -n ${wanted[$path]:-} ]] || continue
  if [[ $mode == 120000 ]]; then
    # git grep skips symlinks: the link target is the blob, scanned here.
    git cat-file blob "$blob" > "$scratch/blob" || scan_error 'git cat-file failed'
    if grep -qaE "$token_re" "$scratch/blob"; then
      hits+=("$path")
    elif (( $? != 1 )); then
      scan_error 'symlink target scan failed'
    fi
  elif [[ -n ${content_hit[$path]:-} ]]; then
    git cat-file blob "$blob" > "$scratch/blob" || scan_error 'git cat-file failed'
    lines=$(grep -naE "$token_re" "$scratch/blob" | cut -d: -f1 | paste -sd, -) \
      || scan_error 'line lookup failed'
    hits+=("$path:$lines")
  fi
done

(( ${#hits[@]} )) || exit 0
echo "$scope a service-token value (dbmcp_svc_…) — locations only, never the value:" >&2
for hit in "${hits[@]}"; do
  while [[ $hit =~ $token_re ]]; do hit=${hit//"${BASH_REMATCH[0]}"/dbmcp_svc_<redacted>}; done
  printf '%s\n' "${hit//[[:cntrl:]]/?}"
done | sort -u >&2
echo "Reference it as \${ENV:…} or \${FILE:…} instead (spec 14)." >&2
exit 1
