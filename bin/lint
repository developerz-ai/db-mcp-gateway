#!/usr/bin/env bash
# bin/lint — read-only style + correctness gate. Same checks as CI fmt+clippy jobs.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "→ cargo fmt --check"
cargo fmt --all -- --check

# shellcheck source=bin/lib/queue.sh
. bin/lib/queue.sh
queue_lock heavy "bin/lint"

# Both passes on `--profile ci`, like CI: one profile, one shared graph.
echo "→ cargo clippy"
cargo clippy --profile ci --all-targets --all-features -- -D warnings

# --all-targets enables cfg(test); the release build does not. Imports used
# only by #[cfg(any(test, debug_assertions))] helpers pass the check above and
# still warn in the shipping build, which is how four unused imports reached
# main invisibly. Lint what actually ships: the release cfg (no test, no
# debug_assertions) on CI's `ci` profile, so the check reuses CI's artifacts
# instead of building a separate --release graph.
echo "→ cargo clippy (release cfg)"
cargo clippy --profile ci --all-features -- -D warnings -C debug-assertions=off

echo "→ scrubber regex features present without dev-dependencies"
bin/check-scrub-features
