#!/usr/bin/env bash
# bin/lint — read-only style + correctness gate. Same checks as CI fmt+clippy jobs.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "→ cargo fmt --check"
cargo fmt --all -- --check

echo "→ cargo clippy"
cargo clippy --all-targets --all-features -- -D warnings

# --all-targets enables cfg(test); the release build does not. Imports used
# only by #[cfg(any(test, debug_assertions))] helpers pass the check above and
# still warn in the shipping build, which is how four unused imports reached
# main invisibly. Lint what actually ships.
echo "→ cargo clippy (release cfg)"
cargo clippy --release --all-features -- -D warnings
