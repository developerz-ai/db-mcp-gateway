#!/usr/bin/env bash
# bin/mint-service-token — mint a static bearer token for a headless client
# (spec 14, `service_accounts:` in the gateway YAML).
#
#   bin/mint-service-token <name>
#
# Prints a fresh `dbmcp_svc_<64 hex>` token, the YAML stanza to add, and the
# env-var name to store the value under. Run by a human operator, never by
# the gateway: there is deliberately no in-band mint API.
#
# After minting:
#   1. Store the token value in the org secret store of record — the
#      value is shown ONCE here and is not recoverable from the gateway.
#   2. Deliver it to the pod as a k8s Secret / SealedSecret mounted env var
#      (or file + `${FILE:…}` ref).
#   3. Add the printed stanza to the gateway config YAML (reviewed by PR),
#      with a matching `permissions:` block for the group.
#   4. Roll the deployment, or `kill -HUP` every pod (a SIGHUP reload swaps
#      the token store with the config — no restart). Delivery-mode caveat:
#      a `${ENV:…}` value is re-resolved from the SAME pod environment on
#      reload, and the pod env is fixed at container start — so a NEW or
#      changed env var only takes effect on a ROLL; only a mounted file
#      (`${FILE:…}`) can be swapped in by SIGHUP.
#
# Rotation requires an explicit overlap phase: every configured token loads
# at once (ServiceTokenStore::from_config resolves ALL of them at boot,
# src/auth/service_token.rs), and boot rejects duplicate service-account
# NAMES (src/config/yaml/service_accounts.rs) AND duplicate token VALUES
# (src/auth/service_token.rs, DuplicateToken) — so the new value CANNOT
# reuse the original <name> nor the original token value. Mint fresh against a
# DISTINCT temporary name (e.g. `<name>-next`): mint new -> add a SECOND
# service_accounts entry (with a distinct name + matching `permissions:` block)
# -> roll or SIGHUP -> update clients -> remove the OLD entry -> roll or
# SIGHUP again. Audit rows
# during the rotation window attribute to the temporary name (`service:<name>-next`)
# instead of the original — document the choice in the PR.
set -euo pipefail

name="${1:-}"
if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; then
  echo "usage: bin/mint-service-token <name>" >&2
  echo "  <name> must match ^[a-z0-9][a-z0-9-]{0,62}\$ — it becomes the audit identity service:<name>" >&2
  exit 2
fi

# 32 bytes of CSPRNG entropy, hex-encoded (64 chars) — matches the exact
# shape the boot validator requires (`dbmcp_svc_` + 64 lowercase hex). A
# token this script emits always satisfies the store's checks.
token="dbmcp_svc_$(openssl rand -hex 32)"
# Env-var name derived from the service name: ci-bot -> SERVICE_TOKEN_CI_BOT.
env_var="SERVICE_TOKEN_$(tr 'a-z-' 'A-Z_' <<< "$name")"

cat <<EOF
token (store this — shown once): ${token}

1. Put the value in the org secret store of record, then deliver it
   to the gateway pod as env var ${env_var} (SealedSecret) — or as a mounted
   file and use \${FILE:/run/secrets/...} below instead.

2. Add to the gateway YAML (the group needs its own permissions: block):

service_accounts:
  - name: ${name}
    group: svc-${name}
    token: \${ENV:${env_var}}

permissions:
  - group: svc-${name}
    grants: []   # fill in the minimal grants this service needs

3. Roll the deployment, or SIGHUP every pod (kill -HUP; a reload swaps the
   token store with the config — no restart). Delivery-mode caveat: an
   \${ENV:…} value is re-resolved from the same pod environment on reload
   (fixed at container start), so a new or changed env var only takes
   effect on a ROLL; only a mounted file (\${FILE:…}) is picked up by
   SIGHUP. Revocation = remove the
   complete stanza (name + group + token ref) and roll or SIGHUP again;
   emptying or unsetting the env is NOT revocation (unresolved refs abort
   boot). Rotation needs an explicit overlap: every configured token loads
   at boot (not one per pod), and boot rejects duplicate service-account
   NAMES and duplicate token VALUES, so mint fresh against a
   DISTINCT temporary name (e.g. <name>-next
   — the same <name> is rejected by src/config/yaml/service_accounts.rs as
   a duplicate; a duplicate token value is rejected by
   src/auth/service_token.rs), add a SECOND stanza under that distinct
   name, roll or SIGHUP, update clients, remove the OLD stanza, roll or
   SIGHUP again.
EOF
