#!/usr/bin/env bash
# bin/mint-service-token — mint a static bearer token for a headless client
# (spec 14, `service_accounts:` in the gateway YAML).
#
#   bin/mint-service-token <name>
#
# A thin wrapper over `db-mcp-gateway mint-service-token <name>`, which prints
# a fresh `dbmcp_svc_<64 hex>` token, the YAML stanza to add, and the env var
# to store it under (the steps, rotation and revocation are in that output and
# in website/docs/deployment/cli.md). The same command ships in the image:
#   docker run --rm ghcr.io/developerz-ai/db-mcp-gateway mint-service-token <name>
#
# Binary: $DB_MCP_GATEWAY_BIN, else `db-mcp-gateway` on PATH, else this
# checkout built with cargo.
set -euo pipefail

if [[ -n "${DB_MCP_GATEWAY_BIN:-}" ]]; then
  exec "$DB_MCP_GATEWAY_BIN" mint-service-token "$@"
fi
if command -v db-mcp-gateway >/dev/null 2>&1; then
  exec db-mcp-gateway mint-service-token "$@"
fi
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec cargo run --quiet --manifest-path "$root/Cargo.toml" --bin db-mcp-gateway -- \
  mint-service-token "$@"
