#!/usr/bin/env bash
# bin/mint-service-token — mint a static bearer token for a headless client
# (spec 14, `service_accounts:` in the gateway YAML).
#
#   bin/mint-service-token <name>
#
# Prints a fresh `dbmcp_svc_<64 hex>` token, the YAML stanza to add, and the
# env-var name to store the value under. Run by a human operator, never by
# the gateway: there is deliberately no in-band mint API.
#
# After minting:
#   1. Store the token value in the org secret store (Vaultwarden) — the
#      value is shown ONCE here and is not recoverable from the gateway.
#   2. Deliver it to the pod as a k8s Secret / SealedSecret mounted env var
#      (or file + `${FILE:…}` ref).
#   3. Add the printed stanza to the gateway config YAML (reviewed by PR),
#      with a matching `permissions:` block for the group.
#   4. Roll the deployment.
#
# Rotation requires an explicit overlap phase because each pod only loads
# one token at boot: mint new -> add a SECOND service_accounts entry -> roll
# -> update clients -> remove the OLD entry -> roll again. If the temp entry
# uses a different <name>, audit rows during the rotation window attribute
# to that name instead of the original — document the choice in the PR.
set -euo pipefail

name="${1:-}"
if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; then
  echo "usage: bin/mint-service-token <name>" >&2
  echo "  <name> must match ^[a-z0-9][a-z0-9-]{0,62}\$ — it becomes the audit identity service:<name>" >&2
  exit 2
fi

# 32 bytes of CSPRNG entropy, hex-encoded (64 chars) — matches the exact
# shape the boot validator requires (`dbmcp_svc_` + 64 lowercase hex). A
# token this script emits always satisfies the store's checks.
token="dbmcp_svc_$(openssl rand -hex 32)"
# Env-var name derived from the service name: ci-bot -> SERVICE_TOKEN_CI_BOT.
env_var="SERVICE_TOKEN_$(tr 'a-z-' 'A-Z_' <<< "$name")"

cat <<EOF
token (store this — shown once): ${token}

1. Put the value in Vaultwarden (org secret store of record), then deliver it
   to the gateway pod as env var ${env_var} (SealedSecret) — or as a mounted
   file and use \${FILE:/run/secrets/...} below instead.

2. Add to the gateway YAML (the group needs its own permissions: block):

service_accounts:
  - name: ${name}
    group: svc-${name}
    token: \${ENV:${env_var}}

permissions:
  - group: svc-${name}
    grants: []   # fill in the minimal grants this service needs

3. Roll the deployment. Revocation = remove the complete stanza (name +
   group + token ref) and roll again; emptying or unsetting the env is NOT
   revocation (unresolved refs abort boot). Rotation needs an explicit
   overlap: mint new, add a SECOND stanza, roll, update clients, remove the
   OLD stanza, roll again.
EOF
