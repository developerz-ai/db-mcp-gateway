{
  "mcpServers": {
    "sentry-mcp": {
      "type": "stdio",
      "command": "bunx",
      "args": ["@sentry/mcp-server@0.42.0"],
      "env": {
        "SENTRY_ACCESS_TOKEN": "${SENTRY_ACCESS_TOKEN}",
        "SENTRY_HOST": "${SENTRY_HOST}"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "env": {
        "DO_NOT_TRACK": "1",
        "CODEGRAPH_TELEMETRY": "0",
        "CODEGRAPH_NO_UPDATE_CHECK": "1"
      }
    }
  }
}
