{
  "repo": "developerz-ai/db-mcp-gateway",
  "ci": {
    "requiredChecks": [
      "clippy",
      "audit",
      "fmt",
      "test"
    ]
  },
  "merge": {
    "reviewGate": "ci-only",
    "classificationParks": "autonomous"
  },
  "labels": { "ready": "ready", "afk": "afk", "hitl": "hitl" },
  "memory": { "teamHandoffDir": ".agent-setup/openclaw-profile/memory/handoff" },
  "repoSync": {
    "reportsDir": ".infra-sync/reports",
    "ciProvider": "github-actions",
    "manifestPaths": [
      "stacks/**/application.yml",
      "stacks/**/manifests/**",
      "stacks/**/kustomization.yml",
      "stacks/**/values.yaml"
    ],
    "importantPathsToFlag": [
      "stacks/platform/**",
      "stacks/stateful/**",
      "stacks/sso/**"
    ],
    "priorityLabels": {
      "P0": ["bug", "incident", "platform", "dr"],
      "P1": ["secrets", "observability", "ready"],
      "P2": ["improvement", "documentation", "area/docs"]
    }
  }
}
