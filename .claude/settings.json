{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo audit:*)",
      "Bash(rustc --version)",
      "Bash(rustup show)",
      "Bash(bin/dev:*)",
      "Bash(bin/test:*)",
      "Bash(bin/fmt:*)",
      "Bash(bin/lint:*)",
      "Bash(bin/ci:*)",
      "Bash(bin/check:*)",
      "Bash(docker compose -f docker-compose.dev.yml:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./**/*.key)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null || exit 0; cd \"${CLAUDE_PROJECT_DIR:?}\" && python3 -I .claude/hooks/guard_bash.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null || exit 0; cd \"${CLAUDE_PROJECT_DIR:?}\" && python3 -I .claude/hooks/post_edit.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
