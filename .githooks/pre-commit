#!/usr/bin/env bash
# pre-commit — the fast gate (a few seconds): formatting, and no service-token
# value in the staged change. pre-push adds clippy + unit tests. The full gate
# is `bin/check` (= bin/ci), run on demand; CI runs the same jobs, not this hook.
# ACTIVATE IT (once, per clone): bin/setup --hooks
#                            or: git config core.hooksPath .githooks
set -euo pipefail
cd "$(dirname "$0")/.."

echo '→ cargo fmt --check'
cargo fmt --all -- --check

# No service-token value in the staged side of the change: contents, file
# names and symlink targets, by the same scanner CI's secret-scan job runs.
bin/secret-scan --staged

if command -v shellcheck >/dev/null 2>&1; then
  # Shell only: `*.sh` plus the extensionless wrappers (bin/lib/*.sql is not).
  # NUL-delimited, so a newline in a name cannot split it.
  list=$(mktemp)
  git diff --cached --name-only -z --diff-filter=ACMR -- 'bin/*' '.githooks/*' 'tests/bin/*.sh' > "$list" \
    || { rm -f "$list"; echo 'pre-commit: git diff --name-only failed' >&2; exit 2; }
  mapfile -d '' -t paths < "$list"
  rm -f "$list"
  scripts=()
  for path in "${paths[@]}"; do
    if [[ $path == *.sh || ${path##*/} != *.* ]]; then scripts+=("$path"); fi
  done
  if (( ${#scripts[@]} )); then
    echo '→ shellcheck (staged scripts)'
    shellcheck -x -- "${scripts[@]}"
  fi
fi
