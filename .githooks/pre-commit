#!/usr/bin/env bash
# pre-commit — the fast gate (a few seconds): formatting, and no service-token
# value in the staged change. pre-push adds clippy + unit tests. The full gate
# is `bin/check` (= bin/ci), run on demand; CI runs the same jobs, not this hook.
# ACTIVATE IT (once, per clone): bin/setup --hooks
#                            or: git config core.hooksPath .githooks
set -euo pipefail
cd "$(dirname "$0")/.."

echo '→ cargo fmt --check'
cargo fmt --all -- --check

# Same regex and exempt paths as CI's secret-scan job, over the staged side of
# the change only: names and index blobs of added, copied, modified, renamed
# and retyped paths. A deletion stages nothing, so removing a leaked file (or
# a leaked file name) always commits. The blobs are scanned as bytes
# (`--text`): a binary file's patch carries no added lines.
token_re='dbmcp_svc_[0-9a-f]{64}'
exempt=(':!tests/**' ':!website/**' ':!config/example.yaml' ':!.github/**' ':!src/config/yaml/**')
scan_error() { echo "pre-commit: secret scan could not run ($1) — refusing the commit." >&2; exit 2; }

names_file=$(mktemp)
trap 'rm -f "$names_file"' EXIT
git diff --cached --name-only -z --diff-filter=ACMRT -- . "${exempt[@]}" > "$names_file" \
  || scan_error 'git diff --name-only failed'
mapfile -d '' -t staged < "$names_file"
by_name=$(tr '\0' '\n' < "$names_file" | grep -E "$token_re") || (( $? == 1 )) || scan_error 'grep failed'
by_content=''
if (( ${#staged[@]} )); then
  # Captured, not piped: grep's early exit cannot SIGPIPE git into a pass.
  by_content=$(git --literal-pathspecs grep --cached --text -l -E "$token_re" -- "${staged[@]}") \
    || (( $? == 1 )) || scan_error 'git grep failed'
fi
if [[ -n $by_content || -n $by_name ]]; then
  # File names only — a token inside a file name is redacted too.
  echo 'pre-commit: the staged change adds a service-token value (dbmcp_svc_…) in:' >&2
  printf '%s\n%s\n' "$by_content" "$by_name" | sed '/^$/d' | sort -u \
    | sed -E "s/${token_re}/dbmcp_svc_<redacted>/g" >&2
  echo "Reference it as \${ENV:…} or \${FILE:…} instead (spec 14)." >&2
  exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
  mapfile -t scripts < <(git diff --cached --name-only --diff-filter=ACMR -- 'bin/*' '.githooks/*' 'tests/bin/*.sh')
  if (( ${#scripts[@]} )); then
    echo '→ shellcheck (staged scripts)'
    shellcheck -x "${scripts[@]}"
  fi
fi
