root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# rustfmt.toml owns Rust formatting (max_width = 100); this only matches it.
[*.rs]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
