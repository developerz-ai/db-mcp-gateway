-- server `prod`, database `app`: read role
-- set the password out of band (psql: \password "mcp_app_ro") and store it where
-- the config's `password:` reference points
CREATE ROLE "mcp_app_ro" LOGIN;
GRANT CONNECT ON DATABASE "app" TO "mcp_app_ro";
GRANT USAGE ON SCHEMA "public" TO "mcp_app_ro";
GRANT SELECT ON ALL TABLES IN SCHEMA "public" TO "mcp_app_ro";
ALTER DEFAULT PRIVILEGES FOR ROLE "app_owner" IN SCHEMA "public" GRANT SELECT ON TABLES TO "mcp_app_ro";
GRANT USAGE ON SCHEMA "sales" TO "mcp_app_ro";
GRANT SELECT ON ALL TABLES IN SCHEMA "sales" TO "mcp_app_ro";
ALTER DEFAULT PRIVILEGES FOR ROLE "app_owner" IN SCHEMA "sales" GRANT SELECT ON TABLES TO "mcp_app_ro";
ALTER ROLE "mcp_app_ro" SET default_transaction_read_only = on;
ALTER ROLE "mcp_app_ro" SET statement_timeout = '30000ms';
ALTER ROLE "mcp_app_ro" SET idle_in_transaction_session_timeout = '60s';
-- write role (`write_role`): narrow the table list to what writes need
CREATE ROLE "mcp_app_rw" LOGIN;
GRANT CONNECT ON DATABASE "app" TO "mcp_app_rw";
GRANT USAGE ON SCHEMA "public" TO "mcp_app_rw";
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA "public" TO "mcp_app_rw";
GRANT USAGE ON ALL SEQUENCES IN SCHEMA "public" TO "mcp_app_rw";
GRANT USAGE ON SCHEMA "sales" TO "mcp_app_rw";
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA "sales" TO "mcp_app_rw";
GRANT USAGE ON ALL SEQUENCES IN SCHEMA "sales" TO "mcp_app_rw";
ALTER ROLE "mcp_app_rw" SET statement_timeout = '30000ms';

# server `cache`, database `0`: ACL user — narrow `%R~*` to the key patterns agents may read
ACL SETUSER gateway_ro on #<sha256-of-password> resetkeys %R~* resetchannels -@all +@read -keys
