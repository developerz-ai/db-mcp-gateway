# Rust
/target
**/*.rs.bk

# Local dev / secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Exception: integration tests need a static RSA keypair to sign the mock
# OIDC IdP's ID tokens. These files are plainly labelled test fixtures and
# never touch a production code path. See tests/common/mod.rs.
!tests/data/*.pem
!tests/data/*.key

# Local config overrides
/config.yml
config/local.yaml
config/*.local.yaml

# Docusaurus — build output + cache, generated in CI, never committed.
/website/node_modules/
/website/build/
/website/.docusaurus/

# Editors
.vscode/
.idea/
*.swp
*~
.DS_Store

# Claude Code per-machine settings (project-shared settings live in .claude/)
.claude/settings.local.json

# CodeGraph local index (per-developer; indexing is opt-in)
.codegraph/

# Test / build artifacts
/coverage
*.profraw
*.profdata

# cargo-chef writes this inside the builder stage; only a local
# `cargo chef prepare` would leave one in the working tree.
recipe.json

# Benchmark output. latest.json — the harness's default --out — is local
# scratch, overwritten every run. The named evidence files (*.json.gz,
# REPORT.md) are committed as the evidence behind the numbers published in
# website/docs/benchmarks.md.
benchmarks/results/latest.json

# Local scratch, including the developerz.ai maintainer agent's tmp/dz/ (staged
# CI logs, run artifacts, run provenance); never repo content.
/tmp/

# Python bytecode from the .claude/hooks and .github/scripts tests.
__pycache__/
