            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/admin/v1/permissions/diff": {
      "post": {
        "summary": "Diff a desired permissions document against the effective one (read-only)",
        "operationId": "diffPermissions",
        "responses": {
          "200": {
            "description": "The diff",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermissionsDiff"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PermissionsDocument"
              }
            }
          },
          "description": "At most 16 MiB; a larger body is 413 `payload_too_large`."
        }
      }
    },
    "/admin/v1/audit/calls": {
      "get": {
        "summary": "Stream audit_calls rows as NDJSON, newest first",
        "operationId": "streamAuditCalls",
        "responses": {
          "200": {
            "description": "One JSON object per line; a final {\"error\": …} line means the stream was cut short",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "user_sub or user_email"
          },
          {
            "name": "server",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "db",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tool",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "spec 03 outcome code"
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "inclusive"
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "exclusive"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1000
            },
            "description": "clamped to 1..=10000"
          },
          {
            "name": "include_sql",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "include the stored statement text and its params"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "gateway session JWT of a caller in the admin group"
      }
    },
    "responses": {
      "Error": {
        "description": "Stable error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "forbidden",
                  "unauthorized",
                  "session_too_old",
                  "not_found",
                  "invalid_request",
                  "payload_too_large",
                  "conflict",
                  "audit_unavailable",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "Constraints": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "require_reason": {
            "type": "boolean"
          },
          "row_limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "statement_timeout_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "Action": {
        "type": "string",
        "enum": [
          "schema_read",
          "query_read",
          "query_write",
          "history_read"
        ]
      },
      "Subject": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "group": {
            "type": "string"
          },
          "user": {
            "type": "string"
          }
        },
        "description": "exactly one of group / user"
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_sub": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_sub",
          "user_email"
        ],
        "properties": {
          "user_sub": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateUser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_email": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Database": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "server": {
            "type": "string"
          },
          "db_name": {
            "type": "string"
          },
          "db_type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateDatabase": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "server",
          "db_name",
          "db_type"
        ],
        "properties": {
          "server": {
            "type": "string"
          },
          "db_name": {
            "type": "string"
          },
          "db_type": {
            "type": "string",
            "enum": [
              "postgres",
              "mysql",
              "mongo",
              "redis"
            ]
          }
        }
      },
      "UpdateDatabase": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "server": {
            "type": "string"
          },
          "db_name": {
            "type": "string"
          },
          "db_type": {
            "type": "string"
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Grant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "database_id": {
            "type": "string",
            "format": "uuid"
          },
          "server": {
            "type": "string"
          },
          "db_name_wildcard": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "enum": [
              "schema_read",
              "query_read",
              "query_write",
              "history_read"
            ]
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "expired": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "action"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "database_id": {
            "type": "string",
            "format": "uuid"
          },
          "server": {
            "type": "string"
          },
          "db_name_wildcard": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "enum": [
              "schema_read",
              "query_read",
              "query_write",
              "history_read"
            ]
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "exactly one target: database_id, or server + db_name_wildcard: true"
      },
      "UpdateGrant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "schema_read",
              "query_read",
              "query_write",
              "history_read"
            ]
          },
          "constraints": {
            "type": "object",
            "description": "per-key patch; null clears a key"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "null clears (never expires)"
          },
          "expected_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changes"
        ],
        "properties": {
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/BatchUpsert"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "op",
                    "id"
                  ],
                  "properties": {
                    "op": {
                      "const": "delete"
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "BatchUpsert": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "user_id",
          "action"
        ],
        "properties": {
          "op": {
            "const": "upsert"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "database_id": {
            "type": "string",
            "format": "uuid"
          },
          "server": {
            "type": "string"
          },
          "db_name_wildcard": {
            "type": "boolean"
          },
          "action": {
            "type": "string",
            "enum": [
              "schema_read",
              "query_read",
              "query_write",
              "history_read"
            ]
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "one batch upsert: `op` plus the CreateGrant fields; exactly one target: database_id, or server + db_name_wildcard: true"
      },
      "BatchResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "created",
                    "updated",
                    "unchanged",
                    "deleted"
                  ]
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "grant": {
                  "$ref": "#/components/schemas/Grant"
                }
              }
            }
          }
        }
      },
      "ExplainRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "server",
          "database",
          "action"
        ],
        "properties": {
          "user": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "with user only; default: the user's cached groups"
          },
          "server": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "schema_read",
              "query_read",
              "query_write",
              "history_read"
            ]
          }
        },
        "description": "exactly one of user / group"
      },
      "DocumentGrant": {
        "type": "object",
        "required": [
          "subject",
          "server",
          "database",
          "action"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "yaml",
              "db"
            ]
          },
          "grant_id": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "$ref": "#/components/schemas/Subject"
          },
          "server": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "schema_read",
              "query_read",
              "query_write",
              "history_read"
            ]
          },
          "constraints": {
            "$ref": "#/components/schemas/Constraints"
          },
          "except": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profile": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "expired": {
            "type": "boolean"
          }
        }
      },
      "Explanation": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "constraints": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Constraints"
              },
              {
                "type": "null"
              }
            ]
          },
          "subject": {
            "$ref": "#/components/schemas/Subject"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groups_source": {
            "type": "string",
            "enum": [
              "stored",
              "none",
              "assumed",
              "group"
            ],
            "description": "Where `groups` came from: `stored` (the user's last-login snapshot), `none` (no snapshot: the user has no `permissions_users` row, so no groups) or `assumed` (the request body) make the answer a simulation, which a live session holding other claims can contradict; `group` for a group question."
          },
          "server": {
            "type": "string"
          },
          "database": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "schema_read",
              "query_read",
              "query_write",
              "history_read"
            ]
          },
          "target_declared": {
            "type": "boolean"
          },
          "matched": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentGrant"
            }
          },
          "expired": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentGrant"
            }
          }
        }
      },
      "PermissionsDocument": {
        "type": "object",
        "required": [
          "grants"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentGrant"
            }
          }
        }
      },
      "PermissionsDiff": {
        "type": "object",
        "properties": {
          "add": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "change": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "unchanged": {
            "type": "integer"
          }
        }
      }
    }
  }
}
