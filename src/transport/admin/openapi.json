{
  "openapi": "3.1.0",
  "info": {
    "title": "db-mcp-gateway admin API",
    "version": "1",
    "description": "SSO-gated admin API (spec 12). Every write commits a permissions_audit row in its own transaction; explain, export, diff and the audit stream write an audit_calls row before responding."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
